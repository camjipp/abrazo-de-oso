---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Single Page with Background Image -->
    <main class="single-page">
        <div class="hero-image-bg">
            <img 
                src="/images/AbrazoDeOsoNoText.png" 
                alt="Bear embracing cub at sunrise over mountain valley - symbolizing family, faith, and work values of Abrazo De Oso Foundation"
                loading="eager"
                fetchpriority="high"
            />
        </div>
        
        <!-- Main Title Overlay -->
        <header class="title-overlay">
            <h1 class="main-title">Abrazo De Oso</h1>
            <p class="subtitle">Faith, Family, and Work</p>
        </header>
        
        <!-- Quote Box Overlay -->
        <aside class="quote-box" aria-label="Inspirational quote">
            <blockquote class="quote-text" cite="Mother Teresa">
                "The problem with the world is that we draw the circle of our family too small. 
                We need to draw it larger every day."
            </blockquote>
            <cite class="quote-author">— Mother Teresa</cite>
            
            <address class="contact-info">
                <a href="mailto:abrazos@abrazosdeoso.com" aria-label="Contact Abrazo De Oso Foundation via email">abrazos@abrazosdeoso.com</a>
            </address>
        </aside>
    </main>
</BaseLayout>

